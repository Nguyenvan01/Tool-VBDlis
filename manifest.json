{
  "manifest_version": 3,
  "name": "Bộ công cụ hỗ trợ VBDLIS (MPLIS)",
  "version": "3.0.0",
  "description": "Xử lý đơn đăng ký trên MPLIS qua API, mỗi chức năng là một công cụ trong cùng Side Panel. Có thống kê và xuất CSV.",
  "permissions": ["storage", "unlimitedStorage", "webNavigation", "sidePanel"],
  "host_permissions": ["https://*.mplis.gov.vn/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Bộ công cụ hỗ trợ VBDLIS",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "panel/panel.html" },
  "commands": {
    "emergency-stop": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Dừng khẩn cấp"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.mplis.gov.vn/*"],
      "js": ["core/hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://*.mplis.gov.vn/*"],
      "js": ["core/context.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://*.mplis.gov.vn/*"],
      "js": [
        "config.js", "core/common.js", "core/model.js", "core/registry.js", "core/log.js",
        "tools/run/rules.js", "tools/run/tool.js",
        "tools/audit/tool.js",
        "tools/undo/rules.js", "tools/undo/tool.js",
        "tools/noaction/rules.js", "tools/noaction/tool.js",
        "tools/dvhc/rules.js", "tools/dvhc/tool.js",
        "core/runner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
